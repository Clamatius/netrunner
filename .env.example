# Netrunner Development Environment Configuration
# Copy this file to .env and customize for your workspace
# This allows running multiple workspaces concurrently on different ports
#
# Syntax dev/load-env.sh accepts:
#   KEY=value             the value is trimmed at both ends
#   KEY=value # comment   a comment starts at a '#' that FOLLOWS WHITESPACE,
#                         so KEY=a#b keeps its '#' as part of the value
#   KEY="value"           quotes preserve interior spaces and '#'
#   KEY='value'           the same, with single quotes
#                         quotes count only at the START of a value, so
#                         KEY=a"b"c is refused rather than guessed at
#   KEY=                  an empty value, so the default below applies
#   # comment             a whole-line comment, indented or not
#
# Refused, each named on stderr with its line number and costing only its own
# line (the rest of the file still loads). This is every refusal the loader
# makes, one per arm in dev/load-env.sh:
#   - a line with no '='
#   - text before the '=' that is not a shell identifier
#   - a key starting with _le_ or __le_, which the loader reserves for itself
#   - an unterminated quote
#   - text after a closing quote that is not a comment
#   - a backslash in the value, because there are no escapes here
#   - a quote part-way through a value (quote the whole value instead)
#   - a name that cannot be assigned, such as a readonly one like UID
#
# Nothing in a value is ever evaluated, so $(...) and backticks stay literal
# text.

# Game server REPL port (where lein repl runs)
# Default: 7888
GAME_SERVER_PORT=7888

# Runner AI client REPL port
# Default: 7889
CLIENT_1_PORT=7889

# Corp AI client REPL port
# Default: 7890
CLIENT_2_PORT=7890

# Web server HTTP port
# Default: 1042
WEB_SERVER_PORT=1042

# Example: Second workspace configuration
# GAME_SERVER_PORT=8888
# CLIENT_1_PORT=8889
# CLIENT_2_PORT=8890
# WEB_SERVER_PORT=2042
