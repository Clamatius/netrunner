# Dev / test / infra commands — NOT used when playing a game. Kept out of the
# default and --full (player) help so the play-facing surface stays legible.
show_help_dev() {
    cat << EOF
${BLUE}AI Player Command Interface — Dev / Test / Infra${NC}
${YELLOW}(not used when playing a game — for player commands: help --full)${NC}

