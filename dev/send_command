#!/bin/bash
# send_command - Simplified AI player control interface
# Usage: ./send_command [client] <action> [args...]
#   Single-client: ./send_command status
#   Multi-client:  ./send_command runner status
#                  ./send_command corp create-game "Test"

set -euo pipefail
set +H  # Disable history expansion to allow ! in function names

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The eval backend is overridable so shell tests can drive this dispatcher with a
# stub REPL (same seam as HEARTBEAT_DIR / PEER_STALE_SECS). A caller-supplied
# backend owns its own liveness, so check_client's port probe skips for it.
AI_EVAL_DEFAULT="$SCRIPT_DIR/ai-eval.sh"
AI_EVAL="${AI_EVAL:-$AI_EVAL_DEFAULT}"
TIMEOUT="${TIMEOUT:-20}"
DEBUG="${DEBUG:-0}"  # Set DEBUG=1 to show verbose output
SHOW_LAST_LOG="${SHOW_LAST_LOG:-0}"  # Set SHOW_LAST_LOG=1 to show last log entry after commands

# Multi-client support: detect if first arg is a client name
# Valid client names: runner, corp, or any custom name
# Port mapping: runner=7889 (default), corp=7890
CLIENT_NAME=""
CLIENT_PORT="7889"
# Heuristic-bot namespace default (overridden per-side below). Initialized here
# so unqualified invocations (e.g. `send_command bot-loop`) don't hit an unbound
# $BOT_NS under set -u.
BOT_NS="ai-heuristic-corp"

# Check if first argument looks like a client name (not a command)
FIRST_ARG="${1:-help}"
if [[ "$FIRST_ARG" =~ ^(runner|corp|[a-z][a-z0-9-]*)$ ]] && [[ ! "$FIRST_ARG" =~ ^(help|status|snapshot|game-over\?|game-over-status|board|hand|prompt|credits|clicks|archives|heap|log|card-text|hand-text|abilities|list-playables|diagnose-blocker|start-turn|indicate-action|take-credit|draw|end-turn|smart-end-turn|remove-tag|purge|trash-resource|change|fix-credits|discard-card|draw-to-card|find-card|keep-hand|mulligan|discard|play|play-index|run|use-ability|use-runner-ability|trash|rez|fire-subs|let-subs-fire|auto-pass|advance|score|choose|choose-value|choose-card|multi-choose|continue|continue-run|monitor-run|jack-out|tank|wait|get-cursor|ping|peer-status|clear-heartbeats|create-game|start-game|leave-game|list-lobbies|join|resync|chat|install|install-index|connect|eval|debug-chat|dashboard|dashboard-compact|bot|bot-turn|bot-status|bot-loop|bot-loop-status|bot-loop-stop)$ ]]; then
    CLIENT_NAME="$1"
    shift

    # Map client name to port and heuristic-bot namespace
    case "$CLIENT_NAME" in
        runner)
            CLIENT_PORT="7889"
            BOT_NS="ai-heuristic-runner"
            ;;
        corp)
            CLIENT_PORT="7890"
            BOT_NS="ai-heuristic-corp"
            ;;
        *)
            # Custom client, try to find its port by checking what's running
            # Default to 7889 if not specified
            CLIENT_PORT="7889"
            BOT_NS="ai-heuristic-corp"
            ;;
    esac
fi

# Color output
# ANSI-C quoting ($'...') embeds real escape chars so colors render in both
# `echo -e` and `cat << EOF` heredocs (the help text). Plain '\033[...]'
# strings only work with echo -e, leaving raw codes in heredoc output.
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
NC=$'\033[0m' # No Color

error() {
    echo -e "${RED}❌ Error: $1${NC}" >&2
    exit 1
}

# Suggest the right command when an unknown one is typed. Discoverability aid for
# the wide surface — a model that guesses 'card'/'card-info' should be pointed at
# 'card-text' rather than just told "unknown". Prints to stderr; never exits.
did_you_mean() {
    local attempted="$1"
    case "$attempted" in
        card|card-info|cardinfo|cardtext|card-text-for|inspect|info|describe|read-card|lookup|whatis)
            echo -e "${YELLOW}💡 Did you mean: card-text <name>${NC}  (look up any card's type/cost/text)" >&2; return;;
        cards|playable|playables|plays|options|moves)
            echo -e "${YELLOW}💡 Did you mean: list-playables${NC}" >&2; return;;
        ability|abilites|card-abilities)
            echo -e "${YELLOW}💡 Did you mean: abilities <name>${NC}" >&2; return;;
        endturn|end|done|pass-turn)
            echo -e "${YELLOW}💡 Did you mean: smart-end-turn  (or end-turn)${NC}" >&2; return;;
        resolve|select|pick|confirm|accept|approve|decline|answer|respond|ok|yes|no)
            echo -e "${YELLOW}💡 Did you mean: choose <N>  (resolve a prompt; also choose-card <N> / choose-value \"<text>\" / multi-choose <i> <j>)${NC}" >&2; return;;
        cont|advance-run|pass|pass-priority|next)
            echo -e "${YELLOW}💡 Did you mean: continue  (pass priority in a run; or monitor-run to participate)${NC}" >&2; return;;
        gain|gain-credit|gain-credits|gaincredit|gaincredits|take-credits|takecredit|click-for-credit)
            echo -e "${YELLOW}💡 Did you mean: take-credit  (basic action: gain 1 [Credit])${NC}" >&2; return;;
        credit)
            echo -e "${YELLOW}💡 Did you mean: take-credit  (gain 1 [Credit]) — or credits  (show credit pools)${NC}" >&2; return;;
    esac
    # Fallback: substring match against the player-facing commands.
    local known="status board hand prompt credits clicks archives heap log card-text abilities list-playables diagnose-blocker start-turn end-turn smart-end-turn draw take-credit play install advance score rez run continue jack-out tank choose choose-card choose-value multi-choose wait get-cursor ping peer-status keep-hand mulligan discard remove-tag game-over-status"
    local hits
    # `|| true`: grep exits non-zero on no match, which under `set -euo pipefail`
    # would abort the whole script *here* — silently swallowing both this hint and
    # the "Unknown command" error that follows. A novel wrong guess (no substring
    # match) is exactly when we most need to print, so the substitution must never fail.
    hits=$(printf '%s\n' $known | grep -iF -- "$attempted" | head -3 | paste -sd'|' - || true)
    if [[ -z "$hits" ]]; then
        # A hyphenated guess like 'show-log' matches nothing whole; retry per
        # token (>=3 chars, so 'to'/'of' don't spray noise) — 'log' should hit.
        # noglob: the guess is untrusted text; unquoted expansion of e.g. 'run*'
        # must split into tokens, not glob against the cwd.
        set -f
        local tok
        for tok in ${attempted//[-_]/ }; do
            [[ ${#tok} -lt 3 ]] && continue
            hits+=$(printf '%s\n' $known | grep -iF -- "$tok" | head -3 | paste -sd'|' - || true)
            hits+='|'
        done
        set +f
        hits=$(printf '%s' "$hits" | tr '|' '\n' | sed '/^$/d' | sort -u | head -3 | paste -sd'|' - || true)
    fi
    if [[ -n "$hits" ]]; then
        # ' | ' separator: a bare space rendered two hits ('credits take-credit')
        # as one mangled command — a seat model tried to run it verbatim.
        echo -e "${YELLOW}💡 Did you mean: ${hits//|/ | }${NC}" >&2
    else
        echo -e "${YELLOW}💡 Run './send_command <side> help' for commands, or 'help --full' for everything.${NC}" >&2
    fi
}

success() {
    [[ "$DEBUG" == "1" ]] && echo -e "${GREEN}✅ $1${NC}"
    return 0
}

info() {
    [[ "$DEBUG" == "1" ]] && echo -e "${BLUE}ℹ️  $1${NC}"
    return 0
}

warn() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

# Check if AI client is running
check_client() {
    # A caller-supplied AI_EVAL (tests) isn't on CLIENT_PORT at all — probing the
    # port would fail the run for a backend we aren't using.
    [[ "$AI_EVAL" != "$AI_EVAL_DEFAULT" ]] && return 0
    if ! lsof -i :$CLIENT_PORT > /dev/null 2>&1; then
        if [[ -n "$CLIENT_NAME" ]]; then
            error "AI Client REPL '$CLIENT_NAME' not running on port $CLIENT_PORT. Start with: ./dev/start-ai-client-repl.sh $CLIENT_NAME $CLIENT_PORT"
        else
            error "AI Client REPL not running on port $CLIENT_PORT. Start with: ./dev/start-ai-client-repl.sh"
        fi
    fi
}

# Refuse an action because there is no game to send it to (#109).
#
# The bug this exists to kill: ensure-synced! diagnosed GAME-GONE correctly,
# printed the correct guidance, returned false — and the command ran anyway
# against cleared state. Every action then invented its own explanation from
# empty fields, because nothing between them agreed on "are we in a game at all?"
# So `draw` claimed '✅ Turn started successfully' then guessed 'deck empty?',
# and `choose 3` blamed the index. The index was fine. The game was gone.
refuse_no_game() {   # VERDICT
    local verdict="$1" side="${CLIENT_NAME:-<side>}"
    case "$verdict" in
        game-over)
            echo -e "${YELLOW}🏁 GAME-OVER — this game is already decided; there is no move to make.${NC}" >&2
            echo    "   '$COMMAND' was NOT sent (it would have been answered from a finished game's state)." >&2
            echo    "   Result:  ./dev/send_command $side game-over-status" >&2
            echo    "   Next:    ./dev/save-replay.sh   ·   ./dev/reset.sh for a fresh game" >&2
            ;;
        *)
            echo -e "${YELLOW}🏚️  GAME-GONE — the server no longer hosts this game; there is nothing to act in.${NC}" >&2
            echo    "   '$COMMAND' was NOT sent. This is the real reason, not 'not your turn' or 'deck empty'." >&2
            echo    "   Confirm: ./dev/send_command $side game-over-status   → GAME-GONE" >&2
            echo    "   Recover: ./dev/reset.sh for a fresh game" >&2
            ;;
    esac
    exit 3
}

# Ensure WebSocket connection is active (auto-reconnect if needed)
#
# Pass --allow-dead for commands that must still work on a dead game: the
# diagnostics a seat uses to CONFIRM the death (wait, get-cursor — the babysit
# loop's only exit condition), the lobby commands that RECOVER from it
# (create-game/join/leave-game/list-lobbies), and local control that must never
# be hostage to server state (bot-loop-stop). Everything else is gated, so a
# newly added command inherits the honest default instead of the lying one.
ensure_connection() {
    local allow_dead=0
    [[ "${1:-}" == "--allow-dead" ]] && allow_dead=1

    # Use the improved ensure-connected! which checks socket health
    # This detects broken sockets where connected? returns true but socket is dead
    local connect_result
    if [[ -n "$CLIENT_NAME" ]]; then
        connect_result=$(TIMEOUT=10 "$AI_EVAL" "$CLIENT_NAME" "$CLIENT_PORT" '(do
          (require (quote [ai-websocket-client-v2 :as ws]))
          (ws/ensure-connected!)
          "ok")' 2>&1)
    else
        connect_result=$(TIMEOUT=10 "$AI_EVAL" '(do
          (require (quote [ai-websocket-client-v2 :as ws]))
          (ws/ensure-connected!)
          "ok")' 2>&1)
    fi

    # Show connection messages if present (they go to stdout)
    if [[ "$connect_result" == *"reconnecting"* ]] || [[ "$connect_result" == *"broken"* ]]; then
        echo "$connect_result" | grep -v '^"ok"$' || true
    fi

    # Check for stale game state and auto-resync if needed.
    # Ask for the VERDICT, not a discarded boolean: which of "in sync" / "decided"
    # / "gone" / "didn't land" we got decides whether this command may proceed.
    local sync_result
    if [[ -n "$CLIENT_NAME" ]]; then
        sync_result=$(TIMEOUT=10 "$AI_EVAL" "$CLIENT_NAME" "$CLIENT_PORT" '(do
          (require (quote [ai-connection :as conn]))
          (str "SYNC-VERDICT " (name (conn/sync-verdict!))))' 2>&1)
    else
        sync_result=$(TIMEOUT=10 "$AI_EVAL" '(do
          (require (quote [ai-connection :as conn]))
          (str "SYNC-VERDICT " (name (conn/sync-verdict!))))' 2>&1)
    fi

    local verdict
    verdict=$(printf '%s\n' "$sync_result" | sed -n 's/.*SYNC-VERDICT \([a-z-]*\).*/\1/p' | tail -1)

    # Show sync messages if present (Stale, Kicked, Resync, or a teardown verdict).
    # The verdict token itself is machine chatter — strip it like the "ok" it replaced.
    if [[ "$sync_result" == *"Stale"* ]] || [[ "$sync_result" == *"Kicked"* ]] || [[ "$sync_result" == *"Resync"* ]] \
       || [[ "$verdict" == "game-gone" ]] || [[ "$verdict" == "game-over" ]]; then
        printf '%s\n' "$sync_result" | grep -v 'SYNC-VERDICT' | grep -v '^"ok"$' || true
    fi

    # Gate. An unparseable verdict (backend hiccup, eval timeout) deliberately
    # falls through to the old behaviour: a broken REPL must not be able to lock
    # a seat out of its own live game.
    if [[ "$allow_dead" -eq 0 ]]; then
        case "$verdict" in
            game-gone|game-over) refuse_no_game "$verdict" ;;
        esac
    fi
}

# Show compact help (default), full player reference (--full), or dev/test (--dev)
show_help() {
    local mode="${1:-}"
    case "$mode" in
        --dev)  show_help_dev ;;
        --full) show_help_full ;;
        *)      show_help_compact ;;
    esac
}

show_help_compact() {
    # Role-aware: a seat only sees the actions legal for its side, so a Runner
    # never reads (or is tempted by) rez/advance/score and a Corp never reads
    # run/jack-out. With no side (./send_command help — human/doc usage) we show
    # the combined form for backward compatibility.
    local role_actions role_running role_examples
    case "$CLIENT_NAME" in
        corp)
            role_actions="${GREEN}Card Actions:${NC}
  play <name>      Play operation
  install <name> <server>  Install into a server (new, HQ, R&D, remote1, ...)
  advance <name>   Advance an installed card
  score <name>     Score an advanced agenda
  rez <name>       Rez ICE / asset / upgrade"
            role_running="${GREEN}Defending Runs:${NC}
  monitor-run      Participate in the opponent's run (auto-pass priority
                   windows, surface real Corp decisions). Required during
                   runner runs — see 'help --full' for flags.
  continue         Pass priority (e.g. decline to rez / fire)."
            role_examples="  ./send_command corp status
  ./send_command corp install \"Hedge Fund\" HQ
  ./send_command corp advance \"Project Atlas\"
  ./send_command corp score \"Project Atlas\""
            ;;
        runner)
            role_actions="${GREEN}Card Actions:${NC}
  play <name>      Play an event
  install <name>   Install a program / resource / hardware"
            role_running="${GREEN}Running:${NC}
  run <server>     Start a run (HQ, R&D, Archives, remote1, etc.)
  continue         Continue run / pass priority
  jack-out         Abort the run (movement window only — not mid-encounter)"
            role_examples="  ./send_command runner status
  ./send_command runner run HQ
  ./send_command runner install \"Cleaver\"
  ./send_command runner choose 0"
            ;;
        *)
            role_actions="${GREEN}Card Actions:${NC}
  play <name>      Play operation/event
  install <name> <server>  Install card (Corp needs server: new, HQ, etc.)
  advance <name>   Advance installed card (Corp)
  score <name>     Score agenda (Corp)
  rez <name>       Rez ICE/asset/upgrade (Corp)"
            role_running="${GREEN}Running:${NC}
  run <server>     Runner: start a run (HQ, R&D, Archives, remote1, etc.)
  continue         Continue run / pass priority
  jack-out         Runner: abort the run (movement window only — not mid-encounter)
  monitor-run      Corp: participate in opponent's run (auto-pass priority
                   windows, surface rez/fire decisions). See 'help --full'."
            role_examples="  ./send_command corp install \"Hedge Fund\" HQ
  ./send_command runner run HQ
  ./send_command runner choose 0"
            ;;
    esac

    cat << EOF
${BLUE}AI Player Command Interface${NC}

${YELLOW}Usage:${NC}
  ./send_command corp|runner <command> [args...]

${GREEN}Essential Commands:${NC}
  snapshot [N]     One-shot: status + prompt + board + hand + last-N log +
                   cursor in ONE call (the per-decision read-loop). Use this.
  status           Show game state (turn, credits, clicks)
  board            Show game board (servers, ICE, installed cards)
  hand             Show cards in hand
  prompt           Show current prompt (if any)

${GREEN}Inspect (read-only — use these to decide):${NC}
  card-text <name>   Look up ANY card's type, cost, and full text
  abilities <name>   Show an installed card's abilities (for use-ability)
  list-playables     List everything you can play/use right now
  diagnose-blocker   Explain why you can/can't act and the one next command to run
  log [N]            Last N game-log entries (default 20)

${GREEN}Turn Actions:${NC}
  start-turn       Start your turn
  take-credit      Spend click for credit
  draw             Spend click to draw
  end-turn         End your turn
  smart-end-turn   End turn if safe (handles discard; recommended)

${role_actions}

${role_running}

${GREEN}Prompts:${NC}
  choose <N|text>  Choose option by index (0 = first) or label text
  choose-card <N>  Select card N from selectable cards

${GREEN}Waiting:${NC}
  get-cursor       Current state cursor (capture BEFORE acting)
  wait [seconds] [--since N]  Block until something we care about happens
                              (prompt, run start/end, my turn, game over,
                              ping).
                              Default 300s timeout. Always pass --since
                              with the cursor you captured before acting.
  ping             Send 'ping' chat to wake opponent's wait
  peer-status      Is my opponent alive? Shows how long since their driver last
                   acted. Use when a wait keeps timing out empty: 'active Ns ago'
                   = still thinking (keep waiting); 'SILENT / likely disconnected'
                   = their process died — conclude, don't wait forever.

${GREEN}Lobby:${NC}
  create-game <title>   Create new game
  keep-hand / mulligan  Mulligan decision
  start-game            Start game after players join

${YELLOW}Examples:${NC}
${role_examples}

${BLUE}For full help:${NC} ./send_command help --full

EOF
}

