{:server/mode "dev"
 :mongodb/connection {:address "localhost"
                      :port 27017
                      :name "netrunner"
                      ; Monger requires a db name in the URI string, be sure to specify
                      :connection-string #or [#env MONGO_CONNECTION_URI nil]}
 :web/app-state nil
 :web/server {:port #long #or [#env WEB_SERVER_PORT 1042]
              :app #ig/ref :web/app}
 :web/auth {:expiration 60
            :secret "Dev salt"
            ;; #157: lets the AI seats connect to /chsk with a bare
            ;; ?client-id=ai-client-<name> instead of a login. wrap-user refuses
            ;; to mint that synthetic user unless this is true, and even then
            ;; only on /chsk - so no other route honours a forged client-id.
            ;; NB this file is the BASE config (prod.edn deep-merges over it),
            ;; so this is an opt-OUT: a deployment that wants no synthetic users
            ;; must set the key false in its own prod.edn. It suppresses the
            ;; synthetic :user only - sente's :user-id-fn (web.ws) accepts a
            ;; raw ?client-id as the socket uid regardless of this flag (#173).
            ;; Deliberately NOT set false in docker/docker-prod.edn: despite the
            ;; name, docker-compose.yml mounts that file as the LOCAL dev
            ;; server's prod.edn (the same compose stack bind-mounts src/ and
            ;; runs a lein repl), so disabling it there would only break docker
            ;; dev seats. Dockerfile.prod installs no config at all - a real
            ;; deployment mounts its own prod.edn, and that is where to set
            ;; :allow-ai-client-fallback? false.
            :allow-ai-client-fallback? true
            :cookie {:http-only true
                     :same-site :lax
                     :secure true
                     ; 60 days
                     :max-age 5184000}}
 :web/lobby {:interval 1000
             :mongo #ig/ref :mongodb/connection
             :time-inactive 172800  ; 2 days (was 600s/10min)
             ;; #76: don't let a dropped socket destroy a started game. Without this,
             ;; bouncing both AI clients (make resume) deletes the lobby outright and
             ;; resync can never recover it. Localhost dev only - upstream/prod default
             ;; is false. Abandoned lobbies are still reaped by :time-inactive above.
             :keep-lobbies-on-disconnect? true}
 :web/chat {:max-length 144
            ;; sliding window size in seconds
            :rate-window 60
            ;; number of messages allowed in the sliding window
            :rate-cnt 10}
 :web/email {:host nil
             :user nil
             :pass nil
             :ssl  nil
             :from "support@jinteki.net"
             :reset-subject "Jinteki Password Reset"
             :confirm-reset-subject "Your password has been changed"}
 :web/app {:server-mode #ig/ref :server/mode
           :mongodb/connection #ig/ref :mongodb/connection
           :web/auth #ig/ref :web/auth
           :web/chat #ig/ref :web/chat
           :web/email #ig/ref :web/email}
 :web/banned-msg {:initial "Account Banned"
                  :mongo #ig/ref :mongodb/connection}
 :web/i18n nil
 :frontend/version {:initial "1"
                    :mongo #ig/ref :mongodb/connection}
 :sente/router nil
 :game/quotes nil
 :jinteki/cards {:mongo #ig/ref :mongodb/connection}}
